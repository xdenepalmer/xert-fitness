{
  "name": "ProgramOffering",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the training program or class type"
    },
    "description": {
      "type": "string",
      "description": "A clear summary of what this program involves and who it suits"
    },
    "category": {
      "type": "string",
      "enum": [
        "functional_class",
        "personal_training",
        "event_prep",
        "allied_health"
      ],
      "default": "functional_class",
      "description": "The type of offering"
    },
    "intensity": {
      "type": "string",
      "enum": [
        "beginner",
        "all_levels",
        "advanced"
      ],
      "default": "all_levels",
      "description": "Intended training intensity / experience level"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Typical session length in minutes"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Whether this offering is shown publicly"
    }
  },
  "required": [
    "title",
    "description"
  ]
}