{
  "name": "XERT Fitness Command Centre",
  "short_name": "XERT Owner",
  "description": "Run XERT Fitness members, classes, publishing and platform operations.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#101820",
  "theme_color": "#101820",
  "icons": [
    {
      "src": "/assets/xert-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/xert-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/xert-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/xert-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Members",
      "short_name": "Members",
      "url": "/admin/gym-members",
      "icons": [{ "src": "/assets/xert-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Class Calendar",
      "short_name": "Classes",
      "url": "/admin/calendar",
      "icons": [{ "src": "/assets/xert-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Workout of the Day",
      "short_name": "Workout",
      "url": "/admin/workouts",
      "icons": [{ "src": "/assets/xert-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}
